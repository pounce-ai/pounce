{
  "name": "pounce-mono",
  "version": "0.1.0",
  "private": true,
  "description": "Pounce — a mobile-first React Native + Expo client (plus a desktop app and a native bridge) for driving Claude Code / agent sessions on your own machine.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "bridge": "node apps/bridge/server.mjs",
    "bridge:install": "bash scripts/bridge-install.sh",
    "bridge:pack": "bun run scripts/bridge/pack.mjs",
    "bridge:qr": "node apps/bridge/pair.mjs",
    "bridge:restart": "pkill -f 'apps/bridge/server.mjs' 2>/dev/null; sleep 1; node apps/bridge/server.mjs",
    "bridge:uninstall": "bash scripts/bridge-uninstall.sh",
    "build": "bun run --filter './packages/*' build",
    "check:naming": "node scripts/check-naming.mjs",
    "cli": "node apps/cli/bin/pounce.mjs",
    "desktop": "cd desktop && bun run start",
    "desktop:macos": "cd desktop && bun run macos",
    "dev:ios": "cd apps/mobile && EXPO_USE_PRECOMPILED_MODULES=0 npx expo run:ios --device",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "mobile": "bun run --filter @pounce/mobile start",
    "publish:ios": "cd apps/mobile && npx eas-cli build --platform ios --profile production --auto-submit",
    "test": "bun run --filter '*' test",
    "testflight": "cd apps/mobile && npx testflight",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@swmansion/argent": "^0.19.0",
    "@types/node": "^22.7.0",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "expo-font": "57.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=20"
  },
  "packageManager": "bun@1.3.14",
  "patchedDependencies": {
    "metro@0.84.4": "patches/metro@0.84.4.patch",
    "metro-runtime@0.84.4": "patches/metro-runtime@0.84.4.patch"
  }
}
