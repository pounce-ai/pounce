  },
  "scripts": {
    "start": "node server.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.58.1",
    "@agentclientprotocol/codex-acp": "^1.1.2",
    "@agentclientprotocol/sdk": "^1.2.1",
    "@pounce/transcript": "workspace:*",
    "@wterm/core": "^0.3.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "zigpty": "^0.2.1"
  }
}
