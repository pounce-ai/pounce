<script is:inline>
  // sticky nav border
  const nav=document.getElementById('nav');
  addEventListener('scroll',()=>nav.classList.toggle('scrolled',scrollY>10),{passive:true});

  // reveal on scroll
  const io=new IntersectionObserver((es)=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{threshold:.12});
  document.querySelectorAll('.reveal').forEach((el,i)=>{el.style.transitionDelay=(i%3*70)+'ms';io.observe(el)});

  // npx copy chip
  (function(){
    const b=document.getElementById('npx-copy');
    if(!b) return;
    let t=null;
    b.addEventListener('click',()=>{
      navigator.clipboard.writeText('npx use-pounce').then(()=>{
        b.classList.add('ok');
        clearTimeout(t); t=setTimeout(()=>b.classList.remove('ok'),1600);
      }).catch(()=>{});
    });
  })();

  // ---- demo reel: cycle real app screens like a product video ----
  (function(){
    const reel=document.getElementById('reel');
    if(!reel) return;
    const frames=JSON.parse(reel.dataset.frames.replace(/&amp;/g,'&'));
    const imgs=reel.querySelectorAll('.frame');
    const barsWrap=document.getElementById('bars');
    const capNo=document.getElementById('cap-no'), capTitle=document.getElementById('cap-title'), capSub=document.getElementById('cap-sub');
    const DUR=3400;
    const reduce=matchMedia('(prefers-reduced-motion:reduce)').matches;

    // build progress bars
    frames.forEach(()=>{const b=document.createElement('div');b.className='b';b.innerHTML='<i></i>';barsWrap.appendChild(b);});
    const bars=barsWrap.querySelectorAll('.b');

    let cur=0, front=0, timer=null, paused=false;
    // preload
    frames.forEach(f=>{const p=new Image();p.src=f.img;});

    function paint(i){
      const f=frames[i];
      const back=imgs[front], show=imgs[front^1];
      show.src=f.img; show.alt=f.cap.replace(/&amp;/g,'&');
      // swap layers with crossfade
      requestAnimationFrame(()=>{show.classList.add('on');back.classList.remove('on');});
      front^=1;
      capNo.textContent=f.no;
      capTitle.textContent=f.cap.replace(/&amp;/g,'&');
      capSub.textContent=f.sub.replace(/&amp;/g,'&');
      bars.forEach((b,bi)=>{b.classList.remove('active','done');b.style.setProperty('--dur',DUR+'ms');if(bi<i)b.classList.add('done');});
      bars[i].classList.add('active');
    }
    function next(){cur=(cur+1)%frames.length;paint(cur);schedule();}
    function schedule(){clearTimeout(timer);if(!reduce&&!paused)timer=setTimeout(next,DUR);}

    paint(0); schedule();
    // pause on hover / when tab hidden
    reel.addEventListener('mouseenter',()=>{paused=true;clearTimeout(timer);});
    reel.addEventListener('mouseleave',()=>{paused=false;schedule();});
    document.addEventListener('visibilitychange',()=>{paused=document.hidden;if(paused){clearTimeout(timer);}else{schedule();}});

    // ---- auto-upgrade to a real recording if assets/demo.mp4 is present ----
    fetch('/assets/demo.mp4',{method:'HEAD'}).then(r=>{
      if(!r.ok) return;
      const v=document.getElementById('reel-video');
      v.src='/assets/demo.mp4'; v.style.display='block';
      imgs.forEach(im=>im.style.display='none');
      barsWrap.style.display='none';
      clearTimeout(timer);
      v.play().catch(()=>{});
    }).catch(()=>{});
  })();
</script>
