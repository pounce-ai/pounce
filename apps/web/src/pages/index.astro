<!-- npx one-liner -->
<section id="cli">
  <div class="wrap">
    <div class="cli-band reveal">
      <div class="cli-copy">
        <span class="kicker">fastest way in</span>
        <h2 class="sec-title" style="font-size:clamp(26px,3.6vw,40px)">One command. Any machine.</h2>
        <p class="sec-lead">Run <b>npx use-pounce</b> on your laptop — or over <b>SSH</b> on a server across the world. It starts the Bridge in the background, prints a QR right in your terminal, and waits for your scan. Works from anywhere: no VPN, no port-forwarding, nothing else to set up.</p>
      </div>
      <div class="term" aria-label="Terminal showing npx use-pounce printing a pairing QR">
        <div class="term-bar"><span class="tl r"></span><span class="tl y"></span><span class="tl g"></span><span class="term-t">any terminal · even over ssh</span></div>
        <div class="term-body">
          <div class="tline"><span class="ps">$</span>npx use-pounce</div>
          <div class="tline dim">Pounce is up on this machine.</div>
          <div class="term-qr"><img src="/assets/pair-qr.svg" alt="Sample pairing QR code" /></div>
          <div class="tline ok">✓ Works from anywhere</div>
          <div class="tline dim">Scan with the Pounce app — or your camera.</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- mcp -->
<section id="mcp">
  <div class="wrap">
    <div class="cli-band reveal">
      <div class="cli-copy">
        <span class="kicker">works with your other agents</span>
        <h2 class="sec-title" style="font-size:clamp(26px,3.6vw,40px)">Your history, in every agent</h2>
        <p class="sec-lead">Every coding agent starts with amnesia — it can't see what you tried in a different tool yesterday. Pounce already reads them all, so one line gives <b>Claude Code</b>, <b>Cursor</b> and anything else that speaks <b>MCP</b> your whole cross-agent history. Read-only, and entirely on your machine.</p>
        <p class="sec-lead" style="margin-top:14px"><a href="/docs/mcp">Read the MCP docs →</a></p>
      </div>
      <div class="term" aria-label="Terminal showing the Pounce MCP server being registered with Claude Code">
        <div class="term-bar"><span class="tl r"></span><span class="tl y"></span><span class="tl g"></span><span class="term-t">one line, any MCP client</span></div>
        <div class="term-body">
          <div class="tline"><span class="ps">$</span>claude mcp add pounce -- npx use-pounce mcp</div>
          <div class="tline ok">✓ Added stdio MCP server pounce</div>
          <div class="tline dim">&nbsp;</div>
          <div class="tline dim">search_history &nbsp; what was already tried</div>
          <div class="tline dim">list_threads &nbsp;&nbsp;&nbsp; sessions across every agent</div>
          <div class="tline dim">get_thread &nbsp;&nbsp;&nbsp;&nbsp;&nbsp; what actually happened</div>
          <div class="tline dim">list_markers &nbsp;&nbsp;&nbsp; what you flagged as important</div>
          <div class="tline dim">recent_activity &nbsp;what's been worked on lately</div>
        </div>
      </div>
    </div>
  </div>
</section>

