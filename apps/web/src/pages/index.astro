---
import BaseHead from "../components/BaseHead.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Shot from "../components/Shot.astro";
import { fetchDownloads, formatSize, RELEASES_PAGE } from "../lib/downloads.ts";
import "../styles/brand.css";

// Resolved at build time so every platform gets a real, direct download link
// instead of being sent to the releases page to guess. See lib/downloads.ts.
const dl = await fetchDownloads();
const dlVersion = dl.version;

/**
 * The four benefit blocks, in the order a real day hits you: the agent stops
 * and waits, you watch it work, you review what it wrote, you find out what it
 * cost. Each one leads with what the visitor gets, not what we built.
 */
const benefits = [
  {
    n: "01",
    eyebrow: "no more silent stalls",
    title: "Know the second it needs you",
    lead: "Agents stop and wait — for a permission, a plan approval, a question only you can answer. Pounce puts that on your phone the moment it happens, and lets you answer it there.",
    points: [
      "Whatever is waiting on you sorts to the top, across every machine",
      "Answer permission and plan prompts without opening a laptop",
      "A push notification when a turn needs you, and when it finishes",
    ],
    shot: "app-home",
    alt: "The Pounce home screen: live agent sessions across a machine, with the ones needing attention pinned to the top",
  },
  {
    n: "02",
    eyebrow: "the whole turn, live",
    title: "Watch it think, not just what it typed",
    lead: "Reasoning, tool calls, file edits, the running token count and the live cost estimate — streaming as it happens. Queue a follow-up and it sends the moment the turn ends.",
    points: [
      "Real-time streaming from Claude Code, Codex, Cursor and opencode",
      "Tool calls and edits expand inline, so you can see what it touched",
      "Switch models mid-thread; talk to it by voice when typing is a pain",
    ],
    shot: "app-session",
    alt: "A live Pounce session streaming an agent's reasoning and tool calls, showing token count and estimated cost in the header",
  },
  {
    n: "03",
    eyebrow: "finish the job",
    title: "Review the diff and ship it, from the sofa",
    lead: "Proper syntax-highlighted diffs per file, marked seen as you go. Then commit, push, or open a draft PR without touching your machine.",
    points: [
      "Full diff review with per-file seen state",
      "Commit with a generated message, push, or open a draft PR",
      "Works on every worktree and branch the agent is running in",
    ],
    shot: "app-changes",
    alt: "The Pounce changes view showing a syntax-highlighted diff with commit, push and draft PR actions",
  },
  {
    n: "04",
    eyebrow: "no surprise invoices",
    title: "See what all of this is actually costing",
    lead: "Tokens, estimated spend, sessions and messages over any window — plus how close each subscription is to its next reset, side by side.",
    points: [
      "Claude, Codex, opencode and Cursor plan usage in one place",
      "Estimated spend per day, project, agent and machine",
      "Costs come from what the agents themselves report, not a guessed price list",
    ],
    shot: "app-activity",
    alt: "The Pounce activity screen showing token totals, estimated spend, and plan usage meters for Claude, opencode, Codex and Cursor",
  },
];
---

<html lang="en">
  <head>
    <BaseHead
      title="Pounce — the control plane for your coding agents"
      description="Claude Code, Codex, Cursor and opencode on your own machines, controlled from your desk and your phone. Hand a colleague one project read-only and revoke it in a tap, give any MCP client your whole cross-agent history, and see exactly what it all cost. Open source, MIT."
      path="/"
      ogSlug="index"
      ogTitle="Pounce — spreading love among your coding agents"
      ogDescription="Scoped, expiring, read-only access grants. Your cross-agent history over MCP. Tokens, spend, plan limits and worktree disk. Free and open source."
    />
  </head>

  <body>
    <div class="glow" aria-hidden="true"></div>
    <Nav />

    <!-- ------------------------------------------------------------ hero -->
    <header class="wrap hero">
      <div class="hero-copy">
        <p class="agent-love">
          Codex <span aria-hidden="true">♥</span> Claude <span aria-hidden="true">♥</span> Cursor
          <span aria-hidden="true">♥</span> opencode
        </p>
        <h1>Spreading love among your coding agents.</h1>
        <p class="lede">
          One home for every agent running on your own machines. Watch them work from your phone,
          lend a teammate a single project, and give any of them everything the others already
          learned.
        </p>

        <div class="cta-row">
          <a
            class="btn btn--primary"
            href="https://apps.apple.com/app/id6779601425"
            target="_blank"
            rel="noopener"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
              ><path
                d="M16.37 1.43c.07 1.06-.32 2.09-1 2.86-.71.79-1.86 1.4-2.98 1.31-.09-1.03.39-2.1 1.04-2.78.72-.78 1.97-1.36 2.94-1.39zM20.5 17.2c-.55 1.27-.82 1.84-1.53 2.96-.99 1.56-2.39 3.51-4.12 3.52-1.54.01-1.94-1-4.03-.99-2.09.01-2.53 1.01-4.07.99-1.73-.02-3.05-1.78-4.04-3.34C-.04 16.46-.34 11.34 1.36 8.62c1.2-1.93 3.1-3.06 4.89-3.06 1.82 0 2.96 1 4.46 1 1.46 0 2.35-1 4.46-1 1.59 0 3.28.87 4.48 2.37-3.94 2.16-3.3 7.78.85 9.27z"
              ></path></svg
            >
            Download for iPhone
          </a>
          <a class="btn btn--ghost" href="#how">See how it works</a>
        </div>

        <button class="npx" id="npx-copy" type="button" aria-label="Copy npx use-pounce configure">
          <span class="ps">$</span><span class="cmd">npx use-pounce configure</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
            ><rect x="9" y="9" width="11" height="11" rx="2"></rect><path
              d="M5 15V5a2 2 0 0 1 2-2h8"></path></svg
          >
          <span class="copied">copied</span>
        </button>
        <p class="npx-note">
          One command on the machine your agents run on. It works out what that machine is, then
          sets it up. That's the whole setup.
        </p>

        <ul class="trust">
          <li>Free &amp; MIT licensed</li>
          <li>Your code never leaves your machine</li>
          <li>Bring your own subscription</li>
        </ul>
      </div>

      <!-- Desktop window with the phone overlapping its corner: the two
           surfaces are the product, and showing only the phone (as the first
           cut of this page did) hid the desktop app entirely. -->
      <div class="hero-shot">
        <div class="mac">
          <Shot
            name="app-desktop"
            width={1440}
            height={897}
            alt="The Pounce desktop app — Spaces sidebar, sessions grouped by what needs attention, and the activity dashboard with tokens, spend, worktree disk and per-plan usage"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <div class="phone phone--float">
          <Shot
            name="app-session"
            width={640}
            height={1391}
            alt="Pounce on iPhone streaming a live agent session"
            loading="eager"
          />
        </div>
      </div>
    </header>

    <!-- ------------------------------------------------- the two strengths -->
    <section id="strengths">
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="eyebrow">what nothing else does</span>
          <h2>Two things Pounce has that the others don't</h2>
        </div>

        <div class="strength reveal">
          <div class="strength-copy">
            <span class="eyebrow">access management</span>
            <h3>Share a project, not your machine</h3>
            <p class="lead">
              Let a colleague read the threads for one repo — and nothing else. The owner decides
              what and for how long, and the answer is always read-only.
            </p>
            <ul class="ticks">
              <li><b>Read-only.</b> They can browse threads, diffs, activity and search — never send a turn, run a command, or read your config</li>
              <li><b>Scoped.</b> Everything, particular projects, or individual threads. New threads in a shared project do appear — you agreed to the project, not a snapshot</li>
              <li><b>Timed.</b> An hour, eight hours, a day, a week, or no expiry. When it lapses the threads disappear from their machine</li>
              <li><b>Revocable.</b> Take it back and it ends immediately</li>
            </ul>
          </div>

          <!-- The handshake, drawn. Two machines, the code that proves which is
               which, and what each of the two approvals actually grants. -->
          <aside class="share-flow">
            <div class="sf-row">
              <div class="sf-node">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                  ><rect x="2" y="4" width="20" height="13" rx="2"></rect><path d="M2 20h20"
                  ></path></svg
                >
                <b>Their laptop</b><small>asks</small>
              </div>

              <div class="sf-link">
                <span class="sf-code" aria-label="Six digit verification code">
                  <i>4</i><i>8</i><i>2</i><i>9</i><i>1</i><i>7</i>
                </span>
                <small>same code on both screens</small>
              </div>

              <div class="sf-node sf-node--owner">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                  ><rect x="3" y="3" width="18" height="13" rx="2"></rect><path
                    d="M8 20h8M12 16v4"></path></svg
                >
                <b>Your machine</b><small>decides</small>
              </div>
            </div>

            <ol class="sf-steps">
              <li>
                <b>Preview</b>
                <span>Project names, counts and dates. No messages, no paths, no branches.</span>
                <em>expires in 5 minutes</em>
              </li>
              <li>
                <b>Read access</b>
                <span>You tick the projects and set the clock. Still read-only.</span>
                <em>1 hour · 8 hours · a day · a week · no expiry</em>
              </li>
              <li>
                <b>Revoke</b>
                <span>The threads disappear from their machine.</span>
                <em>takes effect immediately</em>
              </li>
            </ol>

            <p class="sf-note">
              Both approvals stop at a person — nothing is ever granted automatically.
            </p>
          </aside>
        </div>

        <div class="strength strength--flip reveal">
          <div class="strength-copy">
            <span class="eyebrow">MCP server</span>
            <h3>Give your agent everything your other agents already learned</h3>
            <p class="lead">
              Every coding agent starts each session with amnesia. It can't see what you tried in a
              different tool yesterday, which approach you already rejected, or what you flagged as
              important. Pounce already reads all four, so it's the one thing that can answer
              <i>"what did Codex try on this bug yesterday?"</i> — and it hands that to any MCP client.
            </p>
            <ul class="ticks">
              <li>Works with Claude Code, Claude Desktop, Cursor, Codex — anything that speaks MCP</li>
              <li>Searches your real history across every agent on the machine</li>
              <li>Read-only and local; nothing is uploaded to add context</li>
            </ul>
          </div>

          <aside class="term">
            <div class="term-bar">
              <span class="tl r"></span><span class="tl y"></span><span class="tl g"></span>
              <span class="term-t">one line, once</span>
            </div>
            <div class="term-body">
              <div class="tline"><span class="ps">$</span>claude mcp add pounce -- npx use-pounce mcp</div>
              <div class="tline ok">✓ Added MCP server "pounce"</div>
              <div class="tline dim">&nbsp;</div>
              <div class="tline dim">The next time Claude Code needs context,</div>
              <div class="tline dim">it can search everything you've done — in</div>
              <div class="tline dim">every agent, on this machine.</div>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- -------------------------------------------------------- benefits -->
    {
      benefits.map((b, i) => (
        <section class={`benefit ${i % 2 === 1 ? "benefit--flip" : ""}`} id={i === 0 ? "how" : undefined}>
          <div class="wrap benefit-in">
            <div class="benefit-copy reveal">
              <span class="eyebrow">
                {b.n} — {b.eyebrow}
              </span>
              <h2>{b.title}</h2>
              <p class="lead">{b.lead}</p>
              <ul class="ticks">
                {b.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            </div>
            <div class="benefit-shot reveal">
              <div class="phone phone--sm">
                <Shot name={b.shot} width={640} height={1391} alt={b.alt} />
              </div>
            </div>
          </div>
        </section>
      ))
    }

    <!-- --------------------------------------------------------- desktop -->
    <section id="desktop">
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="eyebrow">the desktop app</span>
          <h2>The whole fleet, on one screen</h2>
          <p class="lead">
            The phone is the remote. The Mac app is the command centre — and it hosts the bridge
            itself, so there is nothing else to install. Windows and Linux run the same thing from
            the tray.
          </p>
        </div>

        <figure class="mac mac--wide reveal">
          <Shot
            name="app-desktop"
            width={1440}
            height={897}
            alt="The Pounce desktop app: Spaces in the sidebar, sessions grouped into needs attention, recent and settled, and the activity dashboard showing 9.1B tokens, estimated spend, 22.6 GB of worktree disk and per-plan usage for Claude, opencode, Codex and Cursor"
          />
        </figure>

        <div class="feat-grid">
          <div class="feat reveal">
            <h4>Spaces</h4>
            <p>Group projects the way you actually think about them, across every machine you've paired.</p>
          </div>
          <div class="feat reveal">
            <h4>Sorted by what's waiting</h4>
            <p>Needs attention, running, recent, settled — so a blocked turn can't sit unnoticed for an hour.</p>
          </div>
          <div class="feat reveal">
            <h4>A docked diff pane</h4>
            <p>Review changes beside the transcript instead of over it, then commit, push or open a PR.</p>
          </div>
          <div class="feat reveal">
            <h4>Native transcript</h4>
            <p>Markdown, code and math rendered natively — long threads scroll like an app, not a web page.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ------------------------------------------------------- analytics -->
    <section id="analytics">
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="eyebrow">deep analytics &amp; controls</span>
          <h2>The numbers nobody else bothers to show you</h2>
          <p class="lead">
            Not just a token count. Where the money went, which plan is about to throttle you, and
            how much disk a year of agent worktrees has quietly eaten.
          </p>
        </div>

        <div class="metrics">
          <div class="metric reveal">
            <span class="m-k">Worktree disk</span>
            <span class="m-v">22.6 GB</span>
            <span class="m-n">across 12 worktrees, so you can find the ones worth reclaiming</span>
          </div>
          <div class="metric reveal">
            <span class="m-k">Estimated spend</span>
            <span class="m-v">~$7,323</span>
            <span class="m-n">by day, project, agent and machine — from what the agents report, not a guessed price list</span>
          </div>
          <div class="metric reveal">
            <span class="m-k">Plan usage</span>
            <span class="m-v">4 agents</span>
            <span class="m-n">Claude, opencode, Codex and Cursor side by side, each with its own reset clock</span>
          </div>
          <div class="metric reveal">
            <span class="m-k">Tokens</span>
            <span class="m-v">9.1B</span>
            <span class="m-n">with the cached share broken out, over any window you pick</span>
          </div>
        </div>

        <p class="metrics-note">
          Figures from one real machine on 14 Aug 2026 — this is a screenshot of the dashboard, not a
          mock-up.
        </p>
      </div>
    </section>

    <!-- ---------------------------------------------------- reach & scale -->
    <section id="reach">
      <div class="wrap">
        <div class="only-grid">
          <article class="card reveal">
            <div class="card-ic" data-tone="brand">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"
                ><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg
              >
            </div>
            <h3>Search everything you've ever run</h3>
            <p>
              One full-text index over the message bodies of every agent on every machine you've
              paired — not just titles. Jump straight to the matched message in the thread it came
              from, months later.
            </p>
          </article>

          <article class="card reveal">
            <div class="card-ic" data-tone="orange">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"
                ><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Z"></path><path
                  d="M2 12h20M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20Z"></path></svg
              >
            </div>
            <h3>Works from anywhere, with nothing to configure</h3>
            <p>
              No Tailscale, no ngrok, no port forwarding, no VPN. The tunnel is built in and turns
              itself on — your phone reaches your machine on hotel wifi and cellular exactly as it
              does at home.
            </p>
          </article>

          <article class="card reveal">
            <div class="card-ic" data-tone="pink">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"
                ><rect x="3" y="4" width="18" height="12" rx="2"></rect><path d="M8 20h8"></path></svg
              >
            </div>
            <h3>Pair a server you never sit in front of</h3>
            <p>
              Run one command over SSH and that box joins the fleet like any other — its own
              credential, its own tunnel, and Pounce tells you which machines are running an old
              build.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- ------------------------------------------------------------- get -->
    <section id="get">
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="eyebrow">two pieces, two minutes</span>
          <h2>Get Pounce</h2>
          <p class="lead">
            The app is the remote. The bridge runs on the computer your agents live on and hosts
            them. Install both, scan one QR code, done.
          </p>
        </div>

        <div class="plat-grid">
          <a
            class="plat reveal"
            href="https://apps.apple.com/app/id6779601425"
            target="_blank"
            rel="noopener"
          >
            <h3>iPhone</h3>
            <p>The full remote — live sessions, voice, diffs and shipping.</p>
            <span class="pill pill--live">Live on the App Store</span>
          </a>

          <a
            class="plat reveal"
            href="https://play.google.com/store/apps/details?id=com.pounce.app"
            target="_blank"
            rel="noopener"
          >
            <h3>Android</h3>
            <p>The same remote — live sessions, voice, diffs and shipping.</p>
            <span class="pill pill--live">Live on Google Play</span>
          </a>

          <a class="plat reveal" data-os="mac" href={dl.macos.url} target="_blank" rel="noopener">
            <h3>macOS</h3>
            <p>The desktop app, with the bridge built in. Signed and notarized, macOS 14+ on Apple Silicon.</p>
            <span class="pill pill--get">
              Download for Mac
              {formatSize(dl.macos.size) && <em class="pill-sub">{formatSize(dl.macos.size)}</em>}
            </span>
          </a>

          <a class="plat reveal" data-os="windows" href={dl.windows.url} target="_blank" rel="noopener">
            <h3>Windows</h3>
            <p>The same desktop app, with the bridge built in. Installer for 64-bit Windows.</p>
            <span class="pill pill--get">
              Download for Windows
              {formatSize(dl.windows.size) && <em class="pill-sub">{formatSize(dl.windows.size)}</em>}
            </span>
          </a>

          <a class="plat reveal" data-os="linux" href={dl.linuxDeb.url} target="_blank" rel="noopener">
            <h3>Linux</h3>
            <p>
              The same desktop app. <span class="mono">.deb</span> for Ubuntu and Debian; a
              self-installing tarball for everything else.
            </p>
            <span class="pill pill--get">
              Download for Linux
              {formatSize(dl.linuxDeb.size) && <em class="pill-sub">.deb · {formatSize(dl.linuxDeb.size)}</em>}
            </span>
          </a>
        </div>

        <!-- The builds that aren't the headline pick for any platform, kept
             close by rather than hidden on the releases page: the wrong-arch
             Linux packages, the non-Debian tarballs, and the headless bridge
             for a server with no desktop at all. -->
        <details class="more-builds reveal">
          <summary>Other builds — Arm, non-Debian Linux, headless servers</summary>
          <ul>
            <li>
              <a href={dl.linuxDebArm.url} target="_blank" rel="noopener">Linux Arm64 <span class="mono">.deb</span></a>
              <span class="mono dim">{formatSize(dl.linuxDebArm.size) ?? "on the releases page"}</span>
            </li>
            <li>
              <a href={dl.linuxTar.url} target="_blank" rel="noopener">Linux x64 tarball</a>
              <span class="mono dim">{formatSize(dl.linuxTar.size) ?? "on the releases page"}</span>
            </li>
            <li>
              <a href={dl.linuxTarArm.url} target="_blank" rel="noopener">Linux Arm64 tarball</a>
              <span class="mono dim">{formatSize(dl.linuxTarArm.size) ?? "on the releases page"}</span>
            </li>
            <li>
              <a href={dl.bridge.url} target="_blank" rel="noopener">Headless bridge</a>
              <span class="mono dim">no GUI · needs Node.js</span>
            </li>
          </ul>
        </details>

        <p class="get-foot">
          {dlVersion && <>Latest release <span class="mono">{dlVersion}</span> — the same version on every platform. </>}
          Prefer the terminal? <span class="mono">npx use-pounce configure</span> sets up any machine —
          including one you only reach over SSH.
          <a href={RELEASES_PAGE} target="_blank" rel="noopener">All releases</a>.
        </p>
      </div>
    </section>

    <!-- ------------------------------------------------------ open source -->
    <section id="oss">
      <div class="wrap oss-band reveal">
        <div>
          <span class="eyebrow">MIT licensed</span>
          <h2>It runs on your machines, and you can read every line.</h2>
          <p class="lead">
            Pounce never proxies your code through a server we own — the app talks to your computer,
            and that's it. The whole thing is on GitHub: the app, the bridge, the tunnel and this
            website.
          </p>
          <div class="cta-row">
            <a
              class="btn btn--primary"
              href="https://github.com/pounce-ai/pounce"
              target="_blank"
              rel="noopener">View the source</a
            >
            <a class="btn btn--ghost" href="/docs/getting-started">Read the docs</a>
          </div>
        </div>
        <img class="oss-mark" src="/assets/icon.png" alt="" width="200" height="200" loading="lazy" />
      </div>
    </section>

    <Footer />

    <style>
      /* ------------------------------------------------------------ glow */
      /* Two soft brand washes behind everything. Fixed, so the page scrolls
         over them rather than dragging them along. */
      .glow {
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        background:
          radial-gradient(620px 520px at 88% -6%, var(--brand-wash), transparent 70%),
          radial-gradient(520px 460px at 4% 12%, rgba(255, 122, 156, 0.09), transparent 68%);
      }

      /* ------------------------------------------------------------ hero */
      /* The visual takes the larger column: the desktop dashboard is dense, and
         at the 450px an even split gave it none of the numbers were readable. */
      .hero {
        display: grid;
        grid-template-columns: 0.86fr 1.14fr;
        gap: 48px;
        align-items: center;
        padding: 64px 24px 92px;
      }
      /* The agent roll-call, as a wordmark rather than a feature list — it
         says "all four, and they get along" faster than a sentence can. */
      .agent-love {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        font-family: var(--mono);
        font-size: 13px;
        letter-spacing: 0.02em;
        color: var(--ink-2);
      }
      .agent-love span {
        color: var(--pink-ink);
        font-size: 15px;
        line-height: 1;
      }

      h1 {
        font-size: clamp(38px, 4.4vw, 56px);
        font-weight: 700;
        margin: 18px 0 22px;
        letter-spacing: -0.026em;
      }
      .lede {
        font-size: clamp(17px, 1.9vw, 20px);
        color: var(--ink-2);
        max-width: 34em;
      }
      .lede b {
        color: var(--ink);
        font-weight: 700;
      }

      .cta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 30px;
      }

      .npx {
        margin-top: 18px;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 12px 18px;
        border-radius: 999px;
        cursor: pointer;
        background: var(--surface);
        border: 1px dashed var(--brand-edge);
        color: var(--ink);
        font-family: var(--mono);
        font-size: 14.5px;
        position: relative;
        transition:
          border-color 0.2s,
          background 0.2s,
          transform 0.2s;
      }
      .npx:hover {
        border-color: var(--brand-ink);
        transform: translateY(-2px);
      }
      .npx .ps {
        color: var(--brand-ink);
      }
      .npx svg {
        width: 15px;
        height: 15px;
        color: var(--ink-3);
      }
      .npx .copied {
        position: absolute;
        top: -10px;
        right: -8px;
        font-size: 10px;
        letter-spacing: 0.04em;
        color: #fff;
        background: var(--green-ink);
        border-radius: 999px;
        padding: 2px 9px;
        opacity: 0;
        transform: translateY(3px);
        transition:
          opacity 0.25s,
          transform 0.25s;
      }
      .npx.ok .copied {
        opacity: 1;
        transform: none;
      }
      .npx-note {
        margin-top: 10px;
        font-size: 14px;
        color: var(--ink-3);
      }

      .trust {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 8px 10px;
        margin-top: 26px;
      }
      .trust li {
        font-size: 13px;
        font-weight: 500;
        color: var(--ink-2);
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 6px 13px;
      }

      /* ----------------------------------------------- phone + mac frames */
      .phone {
        border-radius: 34px;
        overflow: hidden;
        border: 1px solid var(--line);
        background: var(--surface-2);
        box-shadow: var(--shadow-lg);
        max-width: 330px;
        margin-inline: auto;
      }
      .phone img {
        width: 100%;
        display: block;
      }
      .phone--sm {
        max-width: 292px;
      }

      .mac {
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid var(--line);
        background: var(--surface-2);
        box-shadow: var(--shadow-lg);
      }
      .mac img {
        width: 100%;
        display: block;
      }
      .mac--wide {
        max-width: 1060px;
        margin: 0 auto 44px;
      }
      /* Below the point where the screenshot would be squeezed unreadable, let
         it scroll inside its own frame instead. The page itself must never
         scroll sideways, so the overflow is contained here. */
      @media (max-width: 860px) {
        .mac--wide {
          overflow-x: auto;
          -webkit-overflow-scrolling: touch;
        }
        .mac--wide img {
          min-width: 820px;
        }
      }

      /* The hero pairs them: the desktop window runs wider than its column so it
         reads as the primary surface, with the phone tucked into the corner. */
      .hero-shot {
        position: relative;
        padding-bottom: 34px;
      }
      .hero-shot .mac {
        width: 118%;
      }
      .phone--float {
        position: absolute;
        right: -2%;
        bottom: 0;
        width: 148px;
        max-width: none;
        border-radius: 22px;
        z-index: 2;
      }

      /* -------------------------------------------------------- benefits */
      section {
        padding: 84px 0;
      }
      .benefit-in {
        display: grid;
        grid-template-columns: 1fr 0.82fr;
        gap: 64px;
        align-items: center;
      }
      .benefit--flip .benefit-copy {
        order: 2;
      }
      .benefit--flip .benefit-shot {
        order: 1;
      }
      .benefit h2 {
        font-size: clamp(28px, 3.7vw, 42px);
        margin: 14px 0 16px;
      }
      .lead {
        color: var(--ink-2);
        font-size: 17.5px;
        max-width: 40em;
      }
      .ticks {
        list-style: none;
        margin-top: 24px;
        display: grid;
        gap: 12px;
      }
      .ticks li {
        position: relative;
        padding-left: 30px;
        color: var(--ink-2);
        font-size: 16px;
      }
      .ticks li::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.42em;
        width: 16px;
        height: 9px;
        border-left: 2.4px solid var(--brand-ink);
        border-bottom: 2.4px solid var(--brand-ink);
        transform: rotate(-45deg);
        border-radius: 1px;
      }

      /* --------------------------------------------------------- section */
      .sec-head {
        max-width: 620px;
        margin-bottom: 44px;
      }
      .sec-head h2 {
        font-size: clamp(28px, 3.9vw, 44px);
        margin: 14px 0 16px;
      }

      /* ------------------------------------------------------- strengths */
      .strength {
        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
        gap: 44px;
        align-items: start;
        padding: 34px 0;
      }
      .strength + .strength {
        border-top: 1px solid var(--line);
        margin-top: 10px;
      }
      .strength--flip .strength-copy {
        order: 2;
      }
      .strength h3 {
        font-size: clamp(24px, 3.1vw, 34px);
        margin: 12px 0 14px;
      }
      .strength .lead {
        font-size: 17px;
      }
      .strength .ticks li b {
        color: var(--ink);
      }

      .share-flow {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius-lg);
        padding: 26px 26px 22px;
        box-shadow: var(--shadow-sm);
      }
      .sf-row {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 12px;
      }
      .sf-node {
        display: grid;
        justify-items: center;
        gap: 4px;
        padding: 16px 10px;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--ground);
        text-align: center;
      }
      .sf-node svg {
        width: 24px;
        height: 24px;
        color: var(--ink-3);
      }
      .sf-node b {
        font-size: 14px;
      }
      .sf-node small {
        font-family: var(--mono);
        font-size: 10.5px;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--ink-3);
      }
      /* The owner's side is the one that decides, so it carries the accent. */
      .sf-node--owner {
        border-color: var(--brand-edge);
        background: var(--brand-wash);
      }
      .sf-node--owner svg {
        color: var(--brand-ink);
      }

      .sf-link {
        display: grid;
        justify-items: center;
        gap: 6px;
      }
      .sf-code {
        display: flex;
        gap: 3px;
      }
      .sf-code i {
        display: grid;
        place-items: center;
        width: 19px;
        height: 24px;
        border-radius: 5px;
        background: var(--surface-2);
        border: 1px solid var(--line);
        font-family: var(--mono);
        font-style: normal;
        font-size: 12.5px;
        color: var(--brand-ink);
      }
      .sf-link small {
        font-size: 11.5px;
        color: var(--ink-3);
        text-align: center;
        max-width: 15ch;
      }

      .sf-steps {
        list-style: none;
        counter-reset: sf;
        display: grid;
        gap: 14px;
        margin-top: 22px;
      }
      .sf-steps li {
        counter-increment: sf;
        position: relative;
        padding-left: 38px;
      }
      .sf-steps li::before {
        content: counter(sf);
        position: absolute;
        left: 0;
        top: 1px;
        width: 26px;
        height: 26px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        background: var(--brand-wash);
        border: 1px solid var(--brand-edge);
        color: var(--brand-ink);
        font-family: var(--mono);
        font-size: 12px;
      }
      .sf-steps b {
        display: block;
        font-size: 15.5px;
      }
      .sf-steps span {
        display: block;
        margin-top: 2px;
        font-size: 14.5px;
        color: var(--ink-2);
      }
      .sf-steps em {
        display: inline-block;
        margin-top: 5px;
        font-family: var(--mono);
        font-style: normal;
        font-size: 11px;
        letter-spacing: 0.03em;
        color: var(--ink-3);
      }
      .sf-note {
        margin-top: 20px;
        padding-top: 16px;
        border-top: 1px solid var(--line-soft);
        font-size: 13.5px;
        color: var(--ink-3);
      }

      /* ------------------------------------------------------- terminal -- */
      .term {
        border-radius: var(--radius);
        overflow: hidden;
        border: 1px solid var(--line);
        background: #16101f;
        box-shadow: var(--shadow-lg);
        font-family: var(--mono);
        font-size: 13px;
      }
      .term-bar {
        height: 34px;
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 0 13px;
        background: #1f1729;
        border-bottom: 1px solid rgba(253, 243, 231, 0.08);
      }
      .tl {
        width: 10px;
        height: 10px;
        border-radius: 50%;
      }
      .tl.r {
        background: #ff5f57;
      }
      .tl.y {
        background: #febc2e;
      }
      .tl.g {
        background: #28c840;
      }
      .term-t {
        flex: 1;
        text-align: center;
        font-size: 11px;
        color: #877a93;
        margin-right: 40px;
      }
      .term-body {
        padding: 18px 18px 22px;
        display: grid;
        gap: 7px;
      }
      /* The terminal is a dark object in both themes — it's a terminal — so its
         type colours are literal rather than tokens. */
      .tline {
        color: #fdf3e7;
        overflow-wrap: anywhere;
      }
      .tline .ps {
        color: #cba9ff;
        margin-right: 8px;
      }
      .tline.ok {
        color: #56d29a;
      }
      .tline.dim {
        color: #877a93;
      }

      /* --------------------------------------------------- desktop feats -- */
      .feat-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
      }
      .feat {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 22px 20px;
        box-shadow: var(--shadow-sm);
      }
      .feat h4 {
        font-family: var(--body);
        font-weight: 700;
        font-size: 16px;
        margin-bottom: 6px;
      }
      .feat p {
        color: var(--ink-2);
        font-size: 14.5px;
      }

      /* ------------------------------------------------------- analytics -- */
      .metrics {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
      }
      .metric {
        display: grid;
        gap: 6px;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius-lg);
        padding: 26px 24px;
        box-shadow: var(--shadow-sm);
      }
      .m-k {
        font-family: var(--mono);
        font-size: 11.5px;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: var(--ink-3);
      }
      .m-v {
        font-family: var(--display);
        font-weight: 700;
        font-size: clamp(28px, 3.4vw, 38px);
        line-height: 1;
        color: var(--brand-ink);
      }
      .m-n {
        color: var(--ink-2);
        font-size: 14px;
      }
      .metrics-note {
        margin-top: 22px;
        font-size: 13.5px;
        color: var(--ink-3);
      }

      /* ------------------------------------------------------- only-grid */
      .only-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
      }
      .card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius-lg);
        padding: 30px 28px;
        box-shadow: var(--shadow-sm);
        transition:
          transform 0.25s ease,
          box-shadow 0.25s ease,
          border-color 0.25s ease;
      }
      .card:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow);
        border-color: var(--brand-edge);
      }
      .card h3 {
        font-size: 21px;
        margin: 18px 0 10px;
      }
      .card p {
        color: var(--ink-2);
        font-size: 15.5px;
      }
      .card-ic {
        width: 46px;
        height: 46px;
        border-radius: 14px;
        display: grid;
        place-items: center;
        background: var(--brand-wash);
        color: var(--brand-ink);
      }
      .card-ic[data-tone="pink"] {
        background: rgba(255, 122, 156, 0.14);
        color: var(--pink-ink);
      }
      .card-ic[data-tone="orange"] {
        background: rgba(252, 171, 63, 0.16);
        color: var(--orange-ink);
      }
      .card-ic svg {
        width: 23px;
        height: 23px;
      }

      /* ------------------------------------------------------- platforms */
      /* Five platforms now (two phones, three desktops), so this auto-fits
         rather than pinning a column count — at four-across the fifth card was
         stranded alone on its own row. */
      .plat-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
        gap: 18px;
      }
      .plat {
        display: block;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius-lg);
        padding: 26px 24px;
        box-shadow: var(--shadow-sm);
        transition:
          transform 0.25s ease,
          border-color 0.25s ease,
          box-shadow 0.25s ease;
      }
      a.plat:hover {
        transform: translateY(-5px);
        border-color: var(--brand-edge);
        box-shadow: var(--shadow);
      }
      .plat[aria-disabled="true"] {
        opacity: 0.72;
      }
      .plat h3 {
        font-size: 20px;
      }
      .plat p {
        color: var(--ink-2);
        font-size: 14.5px;
        margin: 8px 0 18px;
        min-height: 63px;
      }
      .pill {
        display: inline-block;
        font-family: var(--mono);
        font-size: 11.5px;
        padding: 5px 11px;
        border-radius: 999px;
        border: 1px solid var(--line);
        color: var(--ink-2);
      }
      .pill--live {
        color: var(--green-ink);
        border-color: color-mix(in srgb, var(--green-ink) 34%, transparent);
      }
      .pill--get {
        color: var(--brand-ink);
        border-color: var(--brand-edge);
      }
      .pill-sub {
        font-style: normal;
        opacity: 0.65;
        margin-left: 7px;
      }

      /* The card matching the visitor's own OS, marked up by the script at the
         end of this page. Progressive: without JS every platform is simply
         shown equally, which is the correct fallback rather than a broken one. */
      .plat[data-current] {
        border-color: var(--brand-edge);
        box-shadow: var(--shadow);
      }
      .plat[data-current] .pill--get {
        background: var(--brand-wash);
      }

      .more-builds {
        margin-top: 22px;
        border-top: 1px solid var(--line);
        padding-top: 16px;
      }
      .more-builds summary {
        cursor: pointer;
        color: var(--ink-2);
        font-size: 14.5px;
      }
      .more-builds ul {
        list-style: none;
        margin: 14px 0 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 10px 24px;
      }
      .more-builds li {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        font-size: 14px;
      }
      .more-builds .dim {
        color: var(--ink-3);
        font-size: 12px;
      }

      .get-foot {
        margin-top: 26px;
        color: var(--ink-3);
        font-size: 15px;
      }

      /* ------------------------------------------------------ open source */
      .oss-band {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 44px;
        align-items: center;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius-xl);
        padding: 46px 44px;
        box-shadow: var(--shadow-sm);
      }
      .oss-band h2 {
        font-size: clamp(25px, 3.2vw, 36px);
        margin: 14px 0 14px;
        max-width: 20ch;
      }
      .oss-mark {
        width: 168px;
        height: 168px;
        border-radius: 38px;
        box-shadow: var(--shadow);
      }

      /* ---------------------------------------------------------- mobile */
      @media (max-width: 1000px) {
        .only-grid,
        .plat-grid,
        .feat-grid,
        .metrics {
          grid-template-columns: repeat(2, 1fr);
        }
      }
      @media (max-width: 860px) {
        .hero,
        .benefit-in,
        .strength {
          grid-template-columns: 1fr;
          gap: 44px;
        }
        .strength--flip .strength-copy {
          order: initial;
        }
        /* The overhang and the floating phone both need a two-column hero to
           make sense; stacked, they just collide. */
        .hero-shot {
          padding-bottom: 0;
        }
        /* The desktop dashboard is a dense 1440px grid — at phone width none of
           its numbers are legible, so it stops being evidence and becomes
           texture. The phone shot carries the hero here; the desktop gets its
           own full-width section further down. */
        .hero-shot .mac {
          display: none;
        }
        .phone--float {
          position: static;
          width: min(280px, 72vw);
          margin: 0 auto;
          border-radius: 30px;
        }
        .hero {
          padding-top: 44px;
          padding-bottom: 64px;
        }
        .benefit--flip .benefit-copy,
        .benefit--flip .benefit-shot {
          order: initial;
        }
        section {
          padding: 60px 0;
        }
        .oss-band {
          grid-template-columns: 1fr;
          padding: 34px 26px;
        }
        .oss-mark {
          width: 120px;
          height: 120px;
          border-radius: 28px;
        }
      }
      @media (max-width: 560px) {
        .only-grid,
        .plat-grid,
        .feat-grid,
        .metrics {
          grid-template-columns: 1fr;
        }
        /* Three columns leaves the machine cards ~67px wide — narrower than the
           words in them. Stack, and turn the code strip into the divider. */
        .sf-row {
          grid-template-columns: 1fr;
          gap: 10px;
        }
        .sf-link {
          padding: 4px 0;
        }
        .plat p {
          min-height: 0;
        }
      }
    </style>

    <script is:inline>
      // Runs immediately AND on later navigations. Registering only an
      // astro:page-load listener is too late when this script arrives inside a
      // swap — that event has already fired for the page being swapped in, so
      // the callback never runs for the navigation that inserted it. Calling
      // init() directly covers that case; the guarded listener covers the rest.
      const initHome = () => {
      // Copy the install one-liner.
      const npx = document.getElementById("npx-copy");
      npx?.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText("npx use-pounce configure");
          npx.classList.add("ok");
          setTimeout(() => npx.classList.remove("ok"), 1600);
        } catch (_) {
          /* clipboard blocked (insecure context, denied permission) — the
             command is right there to select by hand, so say nothing */
        }
      });

      // Point the visitor at their own platform's download. Every card stays
      // visible and clickable — this only marks which one is theirs, so a
      // wrong guess costs nothing and no-JS costs nothing either.
      const ua = navigator.userAgent;
      const platform = navigator.userAgentData?.platform || navigator.platform || "";
      const currentOs = /Win/i.test(platform) || /Windows/i.test(ua)
        ? "windows"
        // Order matters: an iPhone's UA contains "Mac" on iPadOS, and Android's
        // contains "Linux". Rule both out before trusting either keyword.
        : /Android|iPhone|iPad|iPod/i.test(ua)
          ? null
          : /Mac/i.test(platform) || /Mac OS X/i.test(ua)
            ? "mac"
            : /Linux|X11/i.test(platform) || /Linux/i.test(ua)
              ? "linux"
              : null;
      if (currentOs) {
        const card = document.querySelector(`.plat[data-os="${currentOs}"]`);
        card?.setAttribute("data-current", "");
      }

      // Reveal on scroll. Anything already on screen at load reveals immediately.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: "0px 0px -12% 0px" },
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
      };

      initHome();
      if (!window.__pounce_initHome) {
        window.__pounce_initHome = true;
        document.addEventListener("astro:page-load", initHome);
      }
    </script>
  </body>
</html>
