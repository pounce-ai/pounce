---
import BaseHead from "../components/BaseHead.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import "../styles/brand.css";

/**
 * The four benefit blocks, in the order a real day hits you: the agent stops
 * and waits, you watch it work, you review what it wrote, you find out what it
 * cost. Each one leads with what the visitor gets, not what we built.
 */
const benefits = [
  {
    n: "01",
    eyebrow: "no more silent stalls",
    title: "Know the second it needs you",
    lead: "Agents stop and wait — for a permission, a plan approval, a question only you can answer. Pounce puts that on your phone the moment it happens, and lets you answer it there.",
    points: [
      "Whatever is waiting on you sorts to the top, across every machine",
      "Answer permission and plan prompts without opening a laptop",
      "A push notification when a turn needs you, and when it finishes",
    ],
    shot: "/assets/app-home.png",
    alt: "The Pounce home screen: live agent sessions across a machine, with the ones needing attention pinned to the top",
  },
  {
    n: "02",
    eyebrow: "the whole turn, live",
    title: "Watch it think, not just what it typed",
    lead: "Reasoning, tool calls, file edits, the running token count and the live cost estimate — streaming as it happens. Queue a follow-up and it sends the moment the turn ends.",
    points: [
      "Real-time streaming from Claude Code, Codex, Cursor and opencode",
      "Tool calls and edits expand inline, so you can see what it touched",
      "Switch models mid-thread; talk to it by voice when typing is a pain",
    ],
    shot: "/assets/app-session.png",
    alt: "A live Pounce session streaming an agent's reasoning and tool calls, showing token count and estimated cost in the header",
  },
  {
    n: "03",
    eyebrow: "finish the job",
    title: "Review the diff and ship it, from the sofa",
    lead: "Proper syntax-highlighted diffs per file, marked seen as you go. Then commit, push, or open a draft PR without touching your machine.",
    points: [
      "Full diff review with per-file seen state",
      "Commit with a generated message, push, or open a draft PR",
      "Works on every worktree and branch the agent is running in",
    ],
    shot: "/assets/app-changes.png",
    alt: "The Pounce changes view showing a syntax-highlighted diff with commit, push and draft PR actions",
  },
  {
    n: "04",
    eyebrow: "no surprise invoices",
    title: "See what all of this is actually costing",
    lead: "Tokens, estimated spend, sessions and messages over any window — plus how close each subscription is to its next reset, side by side.",
    points: [
      "Claude, Codex, opencode and Cursor plan usage in one place",
      "Estimated spend per day, project, agent and machine",
      "Costs come from what the agents themselves report, not a guessed price list",
    ],
    shot: "/assets/app-activity.png",
    alt: "The Pounce activity screen showing token totals, estimated spend, and plan usage meters for Claude, opencode, Codex and Cursor",
  },
];
---

<html lang="en">
  <head>
    <BaseHead
      title="Pounce — your coding agents, in your pocket"
      description="Claude Code, Codex, Cursor and opencode run on your own machines. Pounce tells you the second one needs you, streams the whole turn to your phone, and lets you review the diff and ship — from anywhere. Open source, MIT."
      path="/"
      ogTitle="Pounce — never babysit a coding agent again"
      ogDescription="Know the second your agent needs you. Watch it work, review the diff, and ship from your phone. Free and open source."
    />
  </head>

  <body>
    <div class="glow" aria-hidden="true"></div>
    <Nav />

    <!-- ------------------------------------------------------------ hero -->
    <header class="wrap hero">
      <div class="hero-copy">
        <span class="eyebrow">Claude Code · Codex · Cursor · opencode</span>
        <h1>Never babysit a coding&nbsp;agent again.</h1>
        <p class="lede">
          Your agents run on your own machines. Pounce tells you the moment one needs you, streams
          the whole turn to your phone, and lets you answer, review the diff, and <b>ship</b> —
          without going back to your desk.
        </p>

        <div class="cta-row">
          <a
            class="btn btn--primary"
            href="https://apps.apple.com/app/id6779601425"
            target="_blank"
            rel="noopener"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
              ><path
                d="M16.37 1.43c.07 1.06-.32 2.09-1 2.86-.71.79-1.86 1.4-2.98 1.31-.09-1.03.39-2.1 1.04-2.78.72-.78 1.97-1.36 2.94-1.39zM20.5 17.2c-.55 1.27-.82 1.84-1.53 2.96-.99 1.56-2.39 3.51-4.12 3.52-1.54.01-1.94-1-4.03-.99-2.09.01-2.53 1.01-4.07.99-1.73-.02-3.05-1.78-4.04-3.34C-.04 16.46-.34 11.34 1.36 8.62c1.2-1.93 3.1-3.06 4.89-3.06 1.82 0 2.96 1 4.46 1 1.46 0 2.35-1 4.46-1 1.59 0 3.28.87 4.48 2.37-3.94 2.16-3.3 7.78.85 9.27z"
              ></path></svg
            >
            Download for iPhone
          </a>
          <a class="btn btn--ghost" href="#how">See how it works</a>
        </div>

        <button class="npx" id="npx-copy" type="button" aria-label="Copy npx use-pounce">
          <span class="ps">$</span><span class="cmd">npx use-pounce</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
            ><rect x="9" y="9" width="11" height="11" rx="2"></rect><path
              d="M5 15V5a2 2 0 0 1 2-2h8"></path></svg
          >
          <span class="copied">copied</span>
        </button>
        <p class="npx-note">One command on the machine your agents run on. That's the setup.</p>

        <ul class="trust">
          <li>Free &amp; MIT licensed</li>
          <li>Your code never leaves your machine</li>
          <li>Bring your own subscription</li>
        </ul>
      </div>

      <div class="hero-shot">
        <div class="phone">
          <img
            src="/assets/app-session.png"
            width="640"
            height="1391"
            alt="Pounce on iPhone streaming a live agent session — reasoning, tool calls, token count and cost"
            fetchpriority="high"
          />
        </div>
      </div>
    </header>

    <!-- -------------------------------------------------------- benefits -->
    {
      benefits.map((b, i) => (
        <section class={`benefit ${i % 2 === 1 ? "benefit--flip" : ""}`} id={i === 0 ? "how" : undefined}>
          <div class="wrap benefit-in">
            <div class="benefit-copy reveal">
              <span class="eyebrow">
                {b.n} — {b.eyebrow}
              </span>
              <h2>{b.title}</h2>
              <p class="lead">{b.lead}</p>
              <ul class="ticks">
                {b.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            </div>
            <div class="benefit-shot reveal">
              <div class="phone phone--sm">
                <img src={b.shot} width="640" height="1391" alt={b.alt} loading="lazy" />
              </div>
            </div>
          </div>
        </section>
      ))
    }

    <!-- ------------------------------------------------------- only ours -->
    <section id="only">
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="eyebrow">what you won't get elsewhere</span>
          <h2>Three things only Pounce does</h2>
        </div>

        <div class="only-grid">
          <article class="card reveal">
            <div class="card-ic" data-tone="brand">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"
                ><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg
              >
            </div>
            <h3>Search everything you've ever run</h3>
            <p>
              One full-text index over the message bodies of every agent on every machine you've
              paired — not just titles. Jump straight to the matched message in the thread it came
              from, months later.
            </p>
          </article>

          <article class="card reveal">
            <div class="card-ic" data-tone="pink">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"
                ><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle
                  cx="9"
                  cy="7"
                  r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"
                ></path></svg
              >
            </div>
            <h3>Lend a teammate one project, not your machine</h3>
            <p>
              Read-only access to exactly the projects you choose, for exactly as long as you choose.
              Everything outside the grant returns "not found" rather than "forbidden", and revoking
              takes effect immediately.
            </p>
          </article>

          <article class="card reveal">
            <div class="card-ic" data-tone="orange">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"
                ><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Z"></path><path
                  d="M2 12h20M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20Z"></path></svg
              >
            </div>
            <h3>Works from anywhere, with nothing to configure</h3>
            <p>
              No Tailscale, no ngrok, no port forwarding, no VPN. The tunnel is built in and turns
              itself on — your phone reaches your machine on hotel wifi and cellular exactly as it
              does at home.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- ------------------------------------------------------------- get -->
    <section id="get">
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="eyebrow">two pieces, two minutes</span>
          <h2>Get Pounce</h2>
          <p class="lead">
            The app is the remote. The bridge runs on the computer your agents live on and hosts
            them. Install both, scan one QR code, done.
          </p>
        </div>

        <div class="plat-grid">
          <a
            class="plat reveal"
            href="https://apps.apple.com/app/id6779601425"
            target="_blank"
            rel="noopener"
          >
            <h3>iPhone</h3>
            <p>The full remote — live sessions, voice, diffs and shipping.</p>
            <span class="pill pill--live">Live on the App Store</span>
          </a>

          <div class="plat reveal" aria-disabled="true">
            <h3>Android</h3>
            <p>The same remote, in testing on Google Play right now.</p>
            <span class="pill pill--wait">In testing</span>
          </div>

          <a
            class="plat reveal"
            href="https://github.com/pounce-ai/pounce/releases/latest"
            target="_blank"
            rel="noopener"
          >
            <h3>macOS</h3>
            <p>Desktop app with the bridge built in. Signed and notarized, macOS 14+ on Apple Silicon.</p>
            <span class="pill pill--get">Download the DMG</span>
          </a>

          <a
            class="plat reveal"
            href="https://github.com/pounce-ai/pounce/releases/latest"
            target="_blank"
            rel="noopener"
          >
            <h3>Windows &amp; Linux</h3>
            <p>
              A real installer — <span class="mono">.exe</span>, <span class="mono">.deb</span> or a
              tarball. Lives in the tray and shows the pairing QR.
            </p>
            <span class="pill pill--get">Get the bridge</span>
          </a>
        </div>

        <p class="get-foot">
          Prefer the terminal? <span class="mono">npx use-pounce</span> on any machine — including one
          you only reach over SSH — pairs it the same way.
        </p>
      </div>
    </section>

    <!-- ------------------------------------------------------ open source -->
    <section id="oss">
      <div class="wrap oss-band reveal">
        <div>
          <span class="eyebrow">MIT licensed</span>
          <h2>It runs on your machines, and you can read every line.</h2>
          <p class="lead">
            Pounce never proxies your code through a server we own — the app talks to your computer,
            and that's it. The whole thing is on GitHub: the app, the bridge, the tunnel and this
            website.
          </p>
          <div class="cta-row">
            <a
              class="btn btn--primary"
              href="https://github.com/pounce-ai/pounce"
              target="_blank"
              rel="noopener">View the source</a
            >
            <a class="btn btn--ghost" href="/docs/getting-started">Read the docs</a>
          </div>
        </div>
        <img class="oss-mark" src="/assets/icon.png" alt="" width="200" height="200" loading="lazy" />
      </div>
    </section>

    <Footer />

    <style>
      /* ------------------------------------------------------------ glow */
      /* Two soft brand washes behind everything. Fixed, so the page scrolls
         over them rather than dragging them along. */
      .glow {
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        background:
          radial-gradient(620px 520px at 88% -6%, var(--brand-wash), transparent 70%),
          radial-gradient(520px 460px at 4% 12%, rgba(255, 122, 156, 0.09), transparent 68%);
      }

      /* ------------------------------------------------------------ hero */
      .hero {
        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
        gap: 56px;
        align-items: center;
        padding: 72px 24px 96px;
      }
      h1 {
        font-size: clamp(42px, 6vw, 72px);
        font-weight: 700;
        margin: 18px 0 22px;
        letter-spacing: -0.028em;
      }
      .lede {
        font-size: clamp(17px, 1.9vw, 20px);
        color: var(--ink-2);
        max-width: 34em;
      }
      .lede b {
        color: var(--ink);
        font-weight: 700;
      }

      .cta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 30px;
      }

      .npx {
        margin-top: 18px;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 12px 18px;
        border-radius: 999px;
        cursor: pointer;
        background: var(--surface);
        border: 1px dashed var(--brand-edge);
        color: var(--ink);
        font-family: var(--mono);
        font-size: 14.5px;
        position: relative;
        transition:
          border-color 0.2s,
          background 0.2s,
          transform 0.2s;
      }
      .npx:hover {
        border-color: var(--brand-ink);
        transform: translateY(-2px);
      }
      .npx .ps {
        color: var(--brand-ink);
      }
      .npx svg {
        width: 15px;
        height: 15px;
        color: var(--ink-3);
      }
      .npx .copied {
        position: absolute;
        top: -10px;
        right: -8px;
        font-size: 10px;
        letter-spacing: 0.04em;
        color: #fff;
        background: var(--green-ink);
        border-radius: 999px;
        padding: 2px 9px;
        opacity: 0;
        transform: translateY(3px);
        transition:
          opacity 0.25s,
          transform 0.25s;
      }
      .npx.ok .copied {
        opacity: 1;
        transform: none;
      }
      .npx-note {
        margin-top: 10px;
        font-size: 14px;
        color: var(--ink-3);
      }

      .trust {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 8px 10px;
        margin-top: 26px;
      }
      .trust li {
        font-size: 13px;
        font-weight: 500;
        color: var(--ink-2);
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 6px 13px;
      }

      /* ----------------------------------------------------------- phone */
      .phone {
        border-radius: 34px;
        overflow: hidden;
        border: 1px solid var(--line);
        background: var(--surface-2);
        box-shadow: var(--shadow-lg);
        max-width: 330px;
        margin-inline: auto;
      }
      .phone img {
        width: 100%;
        display: block;
      }
      .phone--sm {
        max-width: 292px;
      }
      .hero-shot {
        position: relative;
      }

      /* -------------------------------------------------------- benefits */
      section {
        padding: 84px 0;
      }
      .benefit-in {
        display: grid;
        grid-template-columns: 1fr 0.82fr;
        gap: 64px;
        align-items: center;
      }
      .benefit--flip .benefit-copy {
        order: 2;
      }
      .benefit--flip .benefit-shot {
        order: 1;
      }
      .benefit h2 {
        font-size: clamp(28px, 3.7vw, 42px);
        margin: 14px 0 16px;
      }
      .lead {
        color: var(--ink-2);
        font-size: 17.5px;
        max-width: 40em;
      }
      .ticks {
        list-style: none;
        margin-top: 24px;
        display: grid;
        gap: 12px;
      }
      .ticks li {
        position: relative;
        padding-left: 30px;
        color: var(--ink-2);
        font-size: 16px;
      }
      .ticks li::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.42em;
        width: 16px;
        height: 9px;
        border-left: 2.4px solid var(--brand-ink);
        border-bottom: 2.4px solid var(--brand-ink);
        transform: rotate(-45deg);
        border-radius: 1px;
      }

      /* --------------------------------------------------------- section */
      .sec-head {
        max-width: 620px;
        margin-bottom: 44px;
      }
      .sec-head h2 {
        font-size: clamp(28px, 3.9vw, 44px);
        margin: 14px 0 16px;
      }

      /* ------------------------------------------------------- only-grid */
      .only-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
      }
      .card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius-lg);
        padding: 30px 28px;
        box-shadow: var(--shadow-sm);
        transition:
          transform 0.25s ease,
          box-shadow 0.25s ease,
          border-color 0.25s ease;
      }
      .card:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow);
        border-color: var(--brand-edge);
      }
      .card h3 {
        font-size: 21px;
        margin: 18px 0 10px;
      }
      .card p {
        color: var(--ink-2);
        font-size: 15.5px;
      }
      .card-ic {
        width: 46px;
        height: 46px;
        border-radius: 14px;
        display: grid;
        place-items: center;
        background: var(--brand-wash);
        color: var(--brand-ink);
      }
      .card-ic[data-tone="pink"] {
        background: rgba(255, 122, 156, 0.14);
        color: var(--pink-ink);
      }
      .card-ic[data-tone="orange"] {
        background: rgba(252, 171, 63, 0.16);
        color: var(--orange-ink);
      }
      .card-ic svg {
        width: 23px;
        height: 23px;
      }

      /* ------------------------------------------------------- platforms */
      .plat-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
      }
      .plat {
        display: block;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius-lg);
        padding: 26px 24px;
        box-shadow: var(--shadow-sm);
        transition:
          transform 0.25s ease,
          border-color 0.25s ease,
          box-shadow 0.25s ease;
      }
      a.plat:hover {
        transform: translateY(-5px);
        border-color: var(--brand-edge);
        box-shadow: var(--shadow);
      }
      .plat[aria-disabled="true"] {
        opacity: 0.72;
      }
      .plat h3 {
        font-size: 20px;
      }
      .plat p {
        color: var(--ink-2);
        font-size: 14.5px;
        margin: 8px 0 18px;
        min-height: 63px;
      }
      .pill {
        display: inline-block;
        font-family: var(--mono);
        font-size: 11.5px;
        padding: 5px 11px;
        border-radius: 999px;
        border: 1px solid var(--line);
        color: var(--ink-2);
      }
      .pill--live {
        color: var(--green-ink);
        border-color: color-mix(in srgb, var(--green-ink) 34%, transparent);
      }
      .pill--get {
        color: var(--brand-ink);
        border-color: var(--brand-edge);
      }
      .get-foot {
        margin-top: 26px;
        color: var(--ink-3);
        font-size: 15px;
      }

      /* ------------------------------------------------------ open source */
      .oss-band {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 44px;
        align-items: center;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius-xl);
        padding: 46px 44px;
        box-shadow: var(--shadow-sm);
      }
      .oss-band h2 {
        font-size: clamp(25px, 3.2vw, 36px);
        margin: 14px 0 14px;
        max-width: 20ch;
      }
      .oss-mark {
        width: 168px;
        height: 168px;
        border-radius: 38px;
        box-shadow: var(--shadow);
      }

      /* ---------------------------------------------------------- mobile */
      @media (max-width: 1000px) {
        .only-grid,
        .plat-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }
      @media (max-width: 860px) {
        .hero,
        .benefit-in {
          grid-template-columns: 1fr;
          gap: 44px;
        }
        .hero {
          padding-top: 44px;
          padding-bottom: 64px;
        }
        .benefit--flip .benefit-copy,
        .benefit--flip .benefit-shot {
          order: initial;
        }
        section {
          padding: 60px 0;
        }
        .oss-band {
          grid-template-columns: 1fr;
          padding: 34px 26px;
        }
        .oss-mark {
          width: 120px;
          height: 120px;
          border-radius: 28px;
        }
      }
      @media (max-width: 560px) {
        .only-grid,
        .plat-grid {
          grid-template-columns: 1fr;
        }
        .plat p {
          min-height: 0;
        }
      }
    </style>

    <script is:inline>
      // Copy the install one-liner.
      const npx = document.getElementById("npx-copy");
      npx?.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText("npx use-pounce");
          npx.classList.add("ok");
          setTimeout(() => npx.classList.remove("ok"), 1600);
        } catch (_) {
          /* clipboard blocked (insecure context, denied permission) — the
             command is right there to select by hand, so say nothing */
        }
      });

      // Reveal on scroll. Anything already on screen at load reveals immediately.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: "0px 0px -12% 0px" },
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
    </script>
  </body>
</html>
