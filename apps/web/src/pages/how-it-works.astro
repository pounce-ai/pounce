<!-- data flow -->
<section>
  <div class="wrap">
    <div class="reveal center">
      <span class="kicker eyebrow">where your data goes</span>
      <h2 class="sec-title">A direct line to your own machine</h2>
      <p class="sec-lead">Nothing is routed through a Pounce server. The app talks straight to the app/Bridge on your computer, which talks to the agents running there.</p>
    </div>
    <div class="flow reveal">
      <div class="node"><div class="nic">📱</div><div class="nt">Pounce app</div><div class="nm">your phone — the remote</div></div>
      <div class="flow-link"><span>same Wi-Fi</span><span class="ln"></span><span>or Pounce tunnel</span></div>
      <div class="node"><div class="nic">🐾</div><div class="nt">The app / Bridge</div><div class="nm">runs on your computer</div></div>
      <div class="flow-link"><span>localhost</span><span class="ln"></span><span>on-device</span></div>
      <div class="node"><div class="nic">🤖</div><div class="nt">Your agents</div><div class="nm">Claude · Codex · Cursor · opencode</div></div>
    </div>
    <p class="flow-note"><b>No Pounce cloud.</b> Your code, diffs and conversations never pass through us — read the <a href="/privacy">privacy policy</a>.</p>
