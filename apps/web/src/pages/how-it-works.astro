---
import BaseHead from "../components/BaseHead.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import "../styles/brand.css";

const steps = [
  {
    n: "1",
    title: "Install it on the computer your agents run on",
    body: "On a Mac, the Pounce desktop app. On Windows or Linux, the bridge bundle. Either one picks up the coding agents already running on that machine — no terminal, no config files.",
    tip: "Terminal person? <b class='mono'>npx use-pounce</b> does the same in one line, and works over SSH — so you can pair a server you never sit in front of.",
  },
  {
    n: "2",
    title: "A pairing code appears",
    body: "It shows a QR code and the address it's listening on. That code carries the machine's address and a private, per-machine token, so only your phone can connect to it.",
    tip: "The token never leaves your devices. Pair once and Pounce remembers the machine, reaching it over its own tunnel when you're away.",
  },
  {
    n: "3",
    title: "Scan it with your phone",
    body: "Open Pounce, tap Sync a device, and point the camera at the code. That is the whole setup — no addresses to type, no tokens to copy.",
    tip: "The built-in Camera app works too — it opens Pounce straight to the pairing screen.",
  },
  {
    n: "4",
    title: "You're connected",
    body: "That machine's sessions sync instantly. Every agent, on every computer you've paired, lands in one list — with whatever is waiting on you at the top.",
    tip: "Pair as many machines as you like. They share one list; filter by device, agent, project or branch.",
  },
];

const faq = [
  {
    q: "Which do I install — app, bridge, or CLI?",
    a: 'On a Mac, the <b>Pounce desktop app</b> (a signed DMG). On Windows or Linux, the headless <b>bridge</b>. Or run <b class="mono">npx use-pounce</b> in any terminal. All three do the same job: host your agents and show a pairing QR. <a href="https://github.com/pounce-ai/pounce/releases/latest" target="_blank" rel="noopener">Get them here.</a>',
  },
  {
    q: "What if my phone and computer are on different networks?",
    a: "Nothing to configure. Pounce opens its own secure peer-to-peer tunnel — pair once with the same QR and your phone reaches your machine over the internet. No VPN, no port forwarding, no Tailscale or ngrok.",
  },
  {
    q: "Is the connection secure?",
    a: "Each machine pairs with its own private token, and off-network access uses a direct peer-to-peer identity to reach home. There is no shared cloud inbox holding your sessions.",
  },
  {
    q: "What can I actually do from the phone?",
    a: 'Stream every agent live, reply or redirect, approve permission and plan prompts, review diffs, then commit, push or open a PR. The <a href="/docs/getting-started">docs</a> have the full tour.',
  },
];
---

<html lang="en">
  <head>
    <BaseHead
      title="How Pounce works — pair your computer in two minutes"
      description="Pounce is a remote control for the coding agents already running on your own machine. Install it on your computer, scan one QR code with your phone, and you're paired. No account, no cloud in the middle."
      path="/how-it-works"
    />
  </head>

  <body>
    <div class="glow" aria-hidden="true"></div>
    <Nav active="how" />

    <header class="wrap page-hero">
      <span class="eyebrow">set up in about two minutes</span>
      <h1>Pounce is a remote for the agents you already run.</h1>
      <p class="lede">
        Nothing runs in our cloud. Install Pounce on the computer where Claude Code, Codex, Cursor or
        opencode already live, scan one QR code with your phone, and the two are paired.
      </p>
      <p class="fine">
        No account · no Pounce server in the middle · your code and conversations stay on your own
        devices
      </p>

      <div class="needs">
        <div class="need">
          <h4>A computer</h4>
          <p>Mac, Windows or Linux — wherever your coding agents actually run.</p>
        </div>
        <div class="need">
          <h4>The Pounce app</h4>
          <p>On iPhone, live on the App Store. Android is in testing on Google Play.</p>
        </div>
        <div class="need">
          <h4>A network path</h4>
          <p>Same wifi just works. Away from home, the built-in tunnel handles it.</p>
        </div>
      </div>
    </header>

    <section>
      <div class="wrap steps">
        {
          steps.map((s) => (
            <article class="step reveal">
              <div class="step-n">{s.n}</div>
              <div>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
                <p class="tip" set:html={s.tip} />
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section>
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="eyebrow">once you're paired</span>
          <h2>Run the whole loop from your phone</h2>
          <p class="lead">
            Watch agents work live, answer what they're stuck on, review the diff, and ship — without
            going back to your desk.
          </p>
        </div>
        <div class="shots">
          <figure class="reveal">
            <div class="phone">
              <img
                src="/assets/app-session.png"
                width="640"
                height="1391"
                alt="A live agent session streaming reasoning and tool calls"
                loading="lazy"
              />
            </div>
            <figcaption><b>Watch it work.</b> Reasoning and tools, live.</figcaption>
          </figure>
          <figure class="reveal">
            <div class="phone">
              <img
                src="/assets/app-changes.png"
                width="640"
                height="1391"
                alt="Reviewing a diff and shipping from the phone"
                loading="lazy"
              />
            </div>
            <figcaption><b>Review and ship.</b> Commit, push, open a PR.</figcaption>
          </figure>
          <figure class="reveal">
            <div class="phone">
              <img
                src="/assets/app-activity.png"
                width="640"
                height="1391"
                alt="Token, spend and plan usage across every agent"
                loading="lazy"
              />
            </div>
            <figcaption><b>Watch the meter.</b> Tokens, spend, plan limits.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="eyebrow">where your data goes</span>
          <h2>A direct line to your own machine</h2>
          <p class="lead">
            Nothing is routed through a Pounce server. The app talks straight to the app or bridge on
            your computer, which talks to the agents running there.
          </p>
        </div>

        <div class="flow reveal">
          <div class="node">
            <div class="nt">Pounce app</div>
            <div class="nm">your phone — the remote</div>
          </div>
          <div class="link"><span>same wifi, or the built-in tunnel</span></div>
          <div class="node">
            <div class="nt">The app / bridge</div>
            <div class="nm">runs on your computer</div>
          </div>
          <div class="link"><span>localhost</span></div>
          <div class="node">
            <div class="nt">Your agents</div>
            <div class="nm">Claude · Codex · Cursor · opencode</div>
          </div>
        </div>
        <p class="flow-note">
          <b>No Pounce cloud.</b> Your code, diffs and conversations never pass through us — read the
          <a href="/privacy.html">privacy policy</a>.
        </p>
      </div>
    </section>

    <section>
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="eyebrow">good to know</span>
          <h2>Common questions</h2>
        </div>
        <div class="faq">
          {
            faq.map((f) => (
              <div class="qa reveal">
                <h4>{f.q}</h4>
                <p set:html={f.a} />
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section>
      <div class="wrap cta-band reveal">
        <h2>Set it up in two minutes</h2>
        <p>
          Grab the iPhone app, install the desktop app or bridge on your computer, and scan once.
        </p>
        <div class="cta-row">
          <a
            class="btn btn--primary"
            href="https://apps.apple.com/app/id6779601425"
            target="_blank"
            rel="noopener">Download for iPhone</a
          >
          <a
            class="btn btn--ghost"
            href="https://github.com/pounce-ai/pounce/releases/latest"
            target="_blank"
            rel="noopener">Desktop app &amp; bridge</a
          >
        </div>
      </div>
    </section>

    <Footer />

    <style>
      .glow {
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        background:
          radial-gradient(600px 500px at 86% -8%, var(--brand-wash), transparent 70%),
          radial-gradient(480px 420px at 2% 6%, rgba(255, 122, 156, 0.08), transparent 68%);
      }

      .page-hero {
        padding: 68px 24px 40px;
        max-width: 900px;
      }
      .page-hero h1 {
        font-size: clamp(36px, 5.2vw, 60px);
        font-weight: 700;
        margin: 16px 0 20px;
        max-width: 17ch;
      }
      .lede {
        font-size: clamp(17px, 1.8vw, 19.5px);
        color: var(--ink-2);
        max-width: 56ch;
      }
      .fine {
        margin-top: 14px;
        font-size: 14px;
        color: var(--ink-3);
      }

      .needs {
        margin-top: 40px;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
      }
      .need {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 20px;
        box-shadow: var(--shadow-sm);
      }
      .need h4 {
        font-family: var(--body);
        font-weight: 700;
        font-size: 15.5px;
        margin-bottom: 6px;
      }
      .need p {
        color: var(--ink-2);
        font-size: 14.5px;
      }

      section {
        padding: 60px 0;
      }
      .sec-head {
        max-width: 620px;
        margin-bottom: 40px;
      }
      .sec-head h2 {
        font-size: clamp(27px, 3.6vw, 40px);
        margin: 12px 0 14px;
      }
      .lead {
        color: var(--ink-2);
        font-size: 17px;
      }

      .steps {
        display: grid;
        gap: 18px;
      }
      .step {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 22px;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius-lg);
        padding: 28px 30px;
        box-shadow: var(--shadow-sm);
      }
      .step-n {
        width: 42px;
        height: 42px;
        border-radius: 13px;
        display: grid;
        place-items: center;
        background: var(--brand-wash);
        color: var(--brand-ink);
        font-family: var(--display);
        font-weight: 700;
        font-size: 20px;
      }
      .step h3 {
        font-size: 22px;
        margin-bottom: 10px;
      }
      .step p {
        color: var(--ink-2);
        font-size: 16px;
        max-width: 62ch;
      }
      .tip {
        margin-top: 14px;
        padding: 12px 16px;
        border-radius: var(--radius-sm);
        background: var(--brand-wash);
        border: 1px solid var(--brand-edge);
        font-size: 14.5px;
        color: var(--ink-2);
      }

      .shots {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 26px;
      }
      .shots figure {
        display: grid;
        gap: 14px;
      }
      .phone {
        border-radius: 28px;
        overflow: hidden;
        border: 1px solid var(--line);
        background: var(--surface-2);
        box-shadow: var(--shadow-lg);
      }
      .shots figcaption {
        text-align: center;
        font-size: 14.5px;
        color: var(--ink-2);
      }
      .shots figcaption b {
        color: var(--ink);
      }

      .flow {
        display: grid;
        grid-template-columns: 1fr auto 1fr auto 1fr;
        align-items: center;
        gap: 14px;
      }
      .node {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 22px 20px;
        text-align: center;
        box-shadow: var(--shadow-sm);
      }
      .nt {
        font-weight: 700;
        font-size: 16.5px;
      }
      .nm {
        color: var(--ink-3);
        font-size: 13.5px;
        margin-top: 4px;
      }
      .link {
        font-family: var(--mono);
        font-size: 11.5px;
        color: var(--ink-3);
        text-align: center;
        max-width: 130px;
      }
      .link::before {
        content: "";
        display: block;
        height: 1px;
        background: var(--line);
        margin-bottom: 8px;
      }
      .flow-note {
        margin-top: 26px;
        font-size: 15px;
        color: var(--ink-2);
      }
      .flow-note a {
        color: var(--brand-ink);
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      .faq {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
      }
      .qa {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 24px 26px;
        box-shadow: var(--shadow-sm);
      }
      .qa h4 {
        font-family: var(--body);
        font-weight: 700;
        font-size: 16.5px;
        margin-bottom: 8px;
      }
      .qa p {
        color: var(--ink-2);
        font-size: 15px;
      }
      .qa a {
        color: var(--brand-ink);
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      .cta-band {
        text-align: center;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius-xl);
        padding: 52px 30px;
        box-shadow: var(--shadow-sm);
      }
      .cta-band h2 {
        font-size: clamp(26px, 3.4vw, 38px);
      }
      .cta-band p {
        color: var(--ink-2);
        margin: 12px auto 24px;
        max-width: 52ch;
      }
      .cta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        justify-content: center;
      }

      @media (max-width: 900px) {
        .needs,
        .shots,
        .faq {
          grid-template-columns: 1fr;
        }
        .flow {
          grid-template-columns: 1fr;
        }
        .link {
          max-width: none;
        }
        .step {
          grid-template-columns: 1fr;
          gap: 14px;
        }
      }
    </style>

    <script is:inline>
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: "0px 0px -10% 0px" },
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
    </script>
  </body>
</html>
