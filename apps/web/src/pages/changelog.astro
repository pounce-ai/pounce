---
import { getCollection, render } from "astro:content";
import { fetchReleases, releaseKey } from "../lib/releases";
import BaseHead from "../components/BaseHead.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import "../styles/brand.css";

const entries = (await getCollection("changelog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const written = await Promise.all(
  entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);

// Every shipped artifact announces itself on GitHub; pulling those in keeps the
// page current without anyone remembering to write a post. A hand-written entry
// wins where both cover the same version — it's the one with something to say.
const covered = new Set(entries.map((e) => releaseKey(e.data.component, e.data.version)));
const releases = (await fetchReleases()).filter(
  (r) => !covered.has(releaseKey(r.component, r.version)),
);

type Item = {
  id: string;
  date: Date;
  component: string;
  version?: string;
  title: string;
  link?: string;
  Content?: (typeof written)[number]["Content"];
  html?: string;
};

const items: Item[] = [
  ...written.map(({ entry, Content }) => ({
    id: entry.id,
    date: entry.data.date,
    component: entry.data.component,
    version: entry.data.version,
    title: entry.data.title,
    link: entry.data.link,
    Content,
  })),
  ...releases.map((r) => ({
    id: r.id,
    date: r.date,
    component: r.component,
    version: r.version,
    title: r.title,
    link: r.link,
    html: r.html,
  })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf());

const COMPONENT_LABELS: Record<string, string> = {
  // A unified `v*` release — every platform at once. The narrower labels below
  // it are the pre-unification history and the parts that still ship on their
  // own schedule.
  app: "All platforms",
  ios: "iPhone",
  android: "Android",
  desktop: "Desktop",
  bridge: "Bridge",
  cli: "CLI",
  tunnel: "Tunnel",
  site: "Site",
};

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" });
---

<html lang="en">
  <head>
    <BaseHead
      title="Pounce — Changelog"
      description="What's new in Pounce — releases and features across the iPhone and Android apps, the desktop app, the bridge, and the use-pounce CLI."
      path="/changelog"
      ogSlug="changelog"
    />
  </head>

  <body>
    <Nav active="changelog" />

    <main class="wrap page">
      <div class="page-h">
        <span class="eyebrow">what's new</span>
        <h1>Changelog</h1>
        <p>
          Releases and features across the iPhone and Android apps, the desktop app, the bridge, and
          the <span class="mono">use-pounce</span> CLI.
        </p>
      </div>

      <div class="log">
        {
          items.map((item) => (
            <article class="entry" id={item.id}>
              <div class="meta">
                <time datetime={item.date.toISOString().slice(0, 10)}>{fmt(item.date)}</time>
                <span class={`chip chip--${item.component}`}>
                  {COMPONENT_LABELS[item.component] ?? item.component}
                </span>
                {item.version && <span class="ver">v{item.version}</span>}
              </div>
              <h2>
                {item.link ? (
                  <a href={item.link} target="_blank" rel="noopener">
                    {item.title}
                  </a>
                ) : (
                  item.title
                )}
              </h2>
              <div class="body">
                {item.Content ? <item.Content /> : <Fragment set:html={item.html} />}
              </div>
            </article>
          ))
        }
      </div>
    </main>

    <Footer />

    <style>
      .page {
        max-width: 860px;
        padding-top: 60px;
        padding-bottom: 30px;
      }
      .page-h {
        margin-bottom: 46px;
      }
      .page-h h1 {
        font-size: clamp(36px, 5.4vw, 56px);
        font-weight: 700;
        margin: 14px 0 12px;
      }
      .page-h p {
        color: var(--ink-2);
        font-size: 17.5px;
        max-width: 56ch;
      }

      .log {
        display: grid;
        gap: 18px;
      }
      .entry {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius-lg);
        padding: 28px 30px;
        box-shadow: var(--shadow-sm);
        scroll-margin-top: 90px;
      }
      .entry:target {
        border-color: var(--brand-edge);
        box-shadow: var(--shadow);
      }

      .meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px;
        font-family: var(--mono);
        font-size: 12px;
        color: var(--ink-3);
      }
      .chip {
        padding: 3px 10px;
        border-radius: 999px;
        border: 1px solid var(--brand-edge);
        color: var(--brand-ink);
        background: var(--brand-wash);
      }
      /* The mobile apps are what most people mean by "Pounce", so they get the
         warm accents; everything else stays on the brand purple. */
      .chip--ios,
      .chip--android {
        color: var(--pink-ink);
        border-color: rgba(255, 122, 156, 0.34);
        background: rgba(255, 122, 156, 0.12);
      }
      .chip--cli,
      .chip--tunnel {
        color: var(--orange-ink);
        border-color: rgba(252, 171, 63, 0.36);
        background: rgba(252, 171, 63, 0.14);
      }
      .ver {
        color: var(--ink-2);
      }

      .entry h2 {
        font-size: clamp(21px, 2.6vw, 27px);
        margin: 14px 0 12px;
      }
      .entry h2 a:hover {
        color: var(--brand-ink);
      }

      .body {
        color: var(--ink-2);
        font-size: 16px;
      }
      .body :global(p) {
        margin-bottom: 12px;
      }
      .body :global(ul),
      .body :global(ol) {
        margin: 0 0 12px 20px;
        display: grid;
        gap: 8px;
      }
      .body :global(h2),
      .body :global(h3) {
        font-size: 18px;
        margin: 20px 0 10px;
        color: var(--ink);
      }
      .body :global(a) {
        color: var(--brand-ink);
        text-decoration: underline;
        text-underline-offset: 3px;
      }
      .body :global(strong) {
        color: var(--ink);
      }
      .body :global(code) {
        font-family: var(--mono);
        font-size: 0.88em;
        background: var(--brand-wash);
        border: 1px solid var(--line-soft);
        border-radius: 6px;
        padding: 1px 6px;
      }
      .body :global(pre) {
        background: var(--surface-2);
        border: 1px solid var(--line);
        border-radius: var(--radius-sm);
        padding: 14px 16px;
        overflow-x: auto;
        margin-bottom: 12px;
      }
      .body :global(pre code) {
        background: none;
        border: 0;
        padding: 0;
      }
      .body :global(img) {
        border-radius: var(--radius-sm);
        border: 1px solid var(--line);
      }
    </style>
  </body>
</html>
