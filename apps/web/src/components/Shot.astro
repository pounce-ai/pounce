---
/**
 * A screenshot that follows the site's theme.
 *
 * Every app screenshot exists twice — captured from the real app in its own
 * light and dark appearance — because a dark dashboard on a cream page (or the
 * reverse) reads as a foreign object dropped into the layout.
 *
 * Both variants are emitted and CSS picks one. It cannot be a `<picture>` with
 * a `prefers-color-scheme` source: the theme toggle sets `data-theme` on the
 * root, and media queries can't see an attribute, so an explicit choice would
 * leave the images showing the OS's preference instead of the visitor's. The
 * selectors below mirror the three states brand.css defines exactly:
 *
 *   bare :root                      → light (the default)
 *   prefers dark, no explicit light → dark
 *   [data-theme="dark"|"light"]     → whatever was chosen, both directions
 *
 * The off-theme variant still downloads. That is the price of switching without
 * a flash of the wrong image, and it is why `loading` is passed through — only
 * the hero pair is eager.
 */
interface Props {
  /** Asset base name: `app-home` resolves to app-home-light.png / -dark.png. */
  name: string;
  alt: string;
  width: number;
  height: number;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "auto";
  class?: string;
}

const {
  name,
  alt,
  width,
  height,
  loading = "lazy",
  fetchpriority,
  class: className,
} = Astro.props;
---

<img
  class:list={["shot", "shot--light", className]}
  src={`/assets/${name}-light.png`}
  width={width}
  height={height}
  alt={alt}
  loading={loading}
  fetchpriority={fetchpriority}
/>
<img
  class:list={["shot", "shot--dark", className]}
  src={`/assets/${name}-dark.png`}
  width={width}
  height={height}
  alt={alt}
  loading={loading}
  fetchpriority={fetchpriority}
/>
<!-- Both carry the same alt and neither is aria-hidden: `display: none` already
     takes the off-theme variant out of the accessibility tree, so exactly one is
     ever announced. Marking the dark one aria-hidden would mute the *visible*
     image for anyone browsing in dark mode. -->

<style is:global>
  /* Light is the default, so the dark variant starts hidden. */
  .shot--dark {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .shot--light {
      display: none;
    }
    :root:not([data-theme="light"]) .shot--dark {
      display: block;
    }
  }

  /* An explicit choice wins over the OS in both directions. */
  :root[data-theme="dark"] .shot--light {
    display: none;
  }
  :root[data-theme="dark"] .shot--dark {
    display: block;
  }
  :root[data-theme="light"] .shot--light {
    display: block;
  }
  :root[data-theme="light"] .shot--dark {
    display: none;
  }
</style>
