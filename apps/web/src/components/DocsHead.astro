---
/**
 * Starlight's `<Head>` with a social card added.
 *
 * Starlight emits `twitter:card="summary_large_image"` and then no image, so
 * every docs page advertised a large card and unfurled bare. It has no config
 * hook for a per-page image — the `head` array in `astro.config.mjs` is static
 * and shared by all sixteen pages — so the component override is the only
 * place a page can point at its own card.
 *
 * The default is rendered first and its tags left alone; this only adds what
 * was missing.
 */
import Default from "@astrojs/starlight/components/Head.astro";
import { OG_HEIGHT, OG_WIDTH } from "../lib/og";
import { ogImagePath, resolveOgSlug } from "../lib/ogPages";
import { breadcrumbs } from "../lib/structuredData";

const route = Astro.locals.starlightRoute;
const site = Astro.site ?? new URL("https://use-pounce.com/");

/**
 * Strip `.html` from Starlight's canonical and `og:url` before the default
 * renders them.
 *
 * Starlight derives both from `Astro.url`, which under `build.format: "file"`
 * ends in `.html` — but Cloudflare serves those flat files under their bare
 * names and 307s `/docs/x.html` to `/docs/x`. Left alone, all sixteen docs
 * pages declare a canonical that redirects away from itself. Starlight exposes
 * no option for this, and `Head.astro` is a plain render of this array, so
 * rewriting the entries is the supported seam.
 */
for (const tag of route?.head ?? []) {
  const attrs = tag.attrs as Record<string, unknown> | undefined;
  if (!attrs) continue;
  if (tag.tag === "link" && attrs.rel === "canonical" && typeof attrs.href === "string") {
    attrs.href = attrs.href.replace(/\.html$/, "");
  }
  if (tag.tag === "meta" && attrs.property === "og:url" && typeof attrs.content === "string") {
    attrs.content = attrs.content.replace(/\.html$/, "");
  }
}

// `entry.id` is the same key `allOgCards()` renders under, but Starlight routes
// that aren't collection entries (the 404) reach here too, so it is checked
// against the emitted set rather than trusted.
const slug = await resolveOgSlug(route?.entry?.id);
const image = new URL(ogImagePath(slug), site).href;
const title = route?.entry?.data?.title ?? "Pounce Docs";

// The 404 resolves to the hero card and is not a place in the docs tree, so it
// gets no trail — a breadcrumb claiming it sits under /docs would be a lie in
// the one place a reader is already lost.
const isDocsPage = slug === "docs" || slug.startsWith("docs/");
const trail = isDocsPage
  ? breadcrumbs([
      { name: "Pounce", path: "/" },
      { name: "Docs", path: "/docs" },
      ...(slug === "docs" ? [] : [{ name: title, path: `/${slug}` }]),
    ])
  : undefined;
---

<Default><slot /></Default>

<meta property="og:image" content={image} />
<meta property="og:image:width" content={String(OG_WIDTH)} />
<meta property="og:image:height" content={String(OG_HEIGHT)} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:alt" content={title} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={title} />

{trail && <script type="application/ld+json" is:inline set:html={JSON.stringify(trail)} />}
