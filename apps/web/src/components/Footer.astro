          <li>
            <a href="https://discord.gg/xK5MQ8KzQH" target="_blank" rel="noopener">Discord</a>
          </li>
          <li>
            <a href="https://github.com/pounce-ai/pounce/releases/latest" target="_blank" rel="noopener"
              >Releases</a
            >
          </li>
          <li>
            <a
              href="https://github.com/pounce-ai/pounce/blob/main/LICENSE"
              target="_blank"
              rel="noopener">MIT License</a
            >
          </li>
        </ul>
      </div>
    </div>

    <div class="foot-bottom">
      <span>© {year} Pounce</span>
      <span><a href="/privacy.html">Privacy</a></span>
    </div>
  </div>
