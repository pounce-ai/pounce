      <div>
        <a class="brand" href="/">
          <img src="/assets/icon.png" alt="" width="34" height="34" />
          pounce
        </a>
        <p style="margin-top:14px;max-width:30ch;color:var(--ink-3);font-size:14.5px">
          Your coding agents, in your pocket. Open source, MIT licensed.
        </p>
      </div>

      <div>
        <h4>Product</h4>
        <ul>
          <li><a href="/how-it-works">How it works</a></li>
          <li><a href="/docs/getting-started">Get started</a></li>
          <li><a href="/changelog">Changelog</a></li>
          <li>
            <a href="https://apps.apple.com/app/id6779601425" target="_blank" rel="noopener"
              >iOS app</a
            >
          </li>
        </ul>
      </div>

      <div>
        <h4>Docs</h4>
        <ul>
          <li><a href="/docs">Overview</a></li>
          <li><a href="/docs/remote-access">Remote access</a></li>
          <li><a href="/docs/cli">CLI</a></li>
          <li><a href="/docs/troubleshooting">Troubleshooting</a></li>
