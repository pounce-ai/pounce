---
/**
 * Starlight's <head>, plus the view transition router.
 *
 * Starlight has no ClientRouter of its own and offers no config flag for it, but
 * it does let you override the Head component — so this renders the stock one
 * and appends the router, which keeps the docs on the same navigation model as
 * the hand-built pages instead of leaving a full reload at the boundary.
 *
 * Starlight's interactive pieces (the theme select, the menu button, the search
 * dialog) are custom elements. Their connectedCallback runs when the swapped-in
 * DOM is inserted, so they re-initialise across a transition without help.
 *
 * The theme bootstrap is injected separately via the `head` array in
 * astro.config.mjs, which is what re-applies data-theme on astro:after-swap.
 */
import Default from "@astrojs/starlight/components/Head.astro";
import { ClientRouter } from "astro:transitions";
---

<Default><slot /></Default>
<ClientRouter />
