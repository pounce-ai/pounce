---
/**
 * Everything that belongs in <head> on a hand-built page: meta, fonts, the view
 * transition router, and the theme bootstrap.
 *
 * The theme script is inlined and `is:inline` on purpose. It has to run before
 * the first paint, or a visitor who chose dark gets a cream flash while the
 * bundle loads — so it cannot be deferred, bundled, or moved to the body.
 */
import { ClientRouter } from "astro:transitions";
import { OG_HEIGHT, OG_WIDTH } from "../lib/og";
import { DEFAULT_OG_SLUG, MARKETING_CARDS, ogImagePath } from "../lib/ogPages";
import { siteGraph } from "../lib/structuredData";
import { THEME_BOOTSTRAP } from "../lib/themeBootstrap";

interface Props {
  title: string;
  description: string;
  path: string;
  ogTitle?: string;
  ogDescription?: string;
  /** Which card in `ogPages.ts` this page unfurls with. */
  ogSlug?: string;
}

const { title, description, path, ogTitle, ogDescription, ogSlug } = Astro.props;

const site = Astro.site ?? new URL("https://use-pounce.com/");

/**
 * Canonicalise on the extensionless URL, because that is the one that answers
 * with the page.
 *
 * `build.format: "file"` emits `privacy.html`, and the store listings point at
 * that path, but Cloudflare serves the flat files under their bare names and
 * **307s `/privacy.html` to `/privacy`**. A canonical pointing at the `.html`
 * form therefore names a URL that redirects away from itself, which is
 * self-defeating: a crawler follows the redirect and canonicalises where it
 * lands. The `.html` links keep working — they just aren't the original.
 */
const canonicalPath = path.replace(/\.html$/, "");
const url = new URL(canonicalPath || "/", site).href;

// Anything that hasn't claimed a card of its own falls back to the landing
// hero rather than to no image, which is what a scraper gets if `og:image`
// points at a path the build never emitted.
const slug = ogSlug && ogSlug in MARKETING_CARDS ? ogSlug : DEFAULT_OG_SLUG;
const image = new URL(ogImagePath(slug), site).href;
const imageAlt = MARKETING_CARDS[slug]?.title ?? "Pounce";
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={url} />
<meta name="robots" content="index, follow" />

<meta property="og:site_name" content="Pounce" />
<meta property="og:type" content="website" />
<meta property="og:locale" content="en" />
<meta property="og:url" content={url} />
<meta property="og:title" content={ogTitle ?? title} />
<meta property="og:description" content={ogDescription ?? description} />
<meta property="og:image" content={image} />
<!-- Dimensions and type let a scraper lay the card out before it has finished
     downloading the image; without them X in particular has been known to fall
     back to `summary` and render a small square. -->
<meta property="og:image:width" content={String(OG_WIDTH)} />
<meta property="og:image:height" content={String(OG_HEIGHT)} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={ogTitle ?? title} />
<meta name="twitter:description" content={ogDescription ?? description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />

<!-- Cream, matching the light ground in brand.css. Light is the site's default
     and the theme script sets the rest; a prefers-color-scheme pair here would
     put the browser chrome back under OS control while the page is not. -->
<meta name="theme-color" content="#fef1e3" />

<link rel="icon" href="/assets/favicon.png" />
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
  rel="stylesheet"
/>

<ClientRouter />

<script type="application/ld+json" is:inline set:html={JSON.stringify(siteGraph())} />

<script is:inline set:html={THEME_BOOTSTRAP} />
