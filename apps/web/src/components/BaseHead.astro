---
/**
 * Everything that belongs in <head> on a hand-built page: meta, fonts, and the
 * theme bootstrap.
 *
 * The theme script is inlined and `is:inline` on purpose. It has to run before
 * the first paint, or a visitor who chose dark gets a cream flash while the
 * bundle loads — so it cannot be deferred, bundled, or moved to the body.
 */
interface Props {
  title: string;
  description: string;
  path: string;
  ogTitle?: string;
  ogDescription?: string;
}

const { title, description, path, ogTitle, ogDescription } = Astro.props;
const url = new URL(path, "https://use-pounce.com/").href;
const image = "https://use-pounce.com/assets/icon.png";
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={url} />
<meta name="robots" content="index, follow" />

<meta property="og:site_name" content="Pounce" />
<meta property="og:type" content="website" />
<meta property="og:url" content={url} />
<meta property="og:title" content={ogTitle ?? title} />
<meta property="og:description" content={ogDescription ?? description} />
<meta property="og:image" content={image} />
<meta property="og:image:alt" content="Pounce — your coding agents, in your pocket" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={ogTitle ?? title} />
<meta name="twitter:description" content={ogDescription ?? description} />
<meta name="twitter:image" content={image} />

<!-- Cream, matching the light ground in brand.css. Light is the site's default
     and the theme script sets the rest; a prefers-color-scheme pair here would
     put the browser chrome back under OS control while the page is not. -->
<meta name="theme-color" content="#fef1e3" />

<link rel="icon" href="/assets/favicon.png" />
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
  rel="stylesheet"
/>

<script is:inline>
  // Runs before first paint, and ALWAYS ends with an explicit data-theme.
  //
  // The site has two themes, light and dark, and light is the default. There is
  // no system/auto mode: when the theme could be implied by the OS instead of
  // stated on the element, the CSS had to match on both `data-theme` and
  // `prefers-color-scheme`, and a screenshot's light and dark variants could
  // both resolve to visible at the same time. One always-present attribute
  // makes that unrepresentable.
  //
  // `starlight-theme` is the ONE key for the whole site, docs included — an
  // earlier version kept its own key and mirrored on write, which only synced
  // one way because Starlight's picker never wrote ours. Starlight may still
  // store "auto" if someone picks it there; with system mode gone, that maps to
  // light like any other unrecognised value.
  try {
    const stored = localStorage.getItem("starlight-theme");
    const theme = stored === "dark" ? "dark" : "light";
    // Settle the value rather than only reading it. Starlight's own provider
    // falls back to the OS when nothing is stored, so leaving it unset would
    // send a first-time visitor on a dark Mac to light here and dark in /docs.
    if (stored !== theme) localStorage.setItem("starlight-theme", theme);
    const root = document.documentElement;
    root.setAttribute("data-theme", theme);
    // Paint the ground here too, not just in the stylesheet. Every navigation is
    // a real document load (Astro is an MPA), and the browser paints its own
    // white default in the gap before the CSS applies — which in dark mode is a
    // white flash on every single click. `color-scheme` also makes the scrollbar
    // and form controls match from the first frame.
    root.style.colorScheme = theme;
    root.style.backgroundColor = theme === "dark" ? "#17111f" : "#fef1e3";
  } catch (_) {
    document.documentElement.setAttribute("data-theme", "light");
  }
</script>
