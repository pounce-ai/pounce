-	} catch {
+		const dirs = [];
+		if (process.env.ZIGPTY_ADDON_DIR) dirs.push(process.env.ZIGPTY_ADDON_DIR);
+		// process.execPath is the compiled binary itself under `bun --compile`
+		// (and the node/bun binary otherwise, where this dir simply won't exist).
+		if (process.execPath) dirs.push(nodePath.join(nodePath.dirname(process.execPath), "prebuilds"));
+		dirs.push(fileURLToPath(new URL("../prebuilds/", import.meta.url)));
+		const failures = [];
+		const attempt = (dir, name) => {
+			const file = nodePath.join(dir, `${name}.node`);
+			try {
+				return require(file);
+			} catch (err) {
